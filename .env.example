# ═══════════════════════════════════════════════
#  环境变量模板 — 复制为 .env 并填入实际值
# ═══════════════════════════════════════════════

# ── 通义千问 (DashScope / 阿里云百炼) ─────────
TONGYI_API_BASE_URL=
TONGYI_API_KEY=
DASHSCOPE_NATIVE_API_BASE_URL=

# ── 备用 LLM (OpenAI 兼容协议) ────────────────
BACKUP_LLM_API_BASE_URL=
BACKUP_LLM_API_KEY=

# ── DeepSeek ──────────────────────────────────
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# ── 知乎 OAuth (黑客松开放平台) ───────────────
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/zhihu/callback
ZHIHU_ACCESS_SECRET=

# ── 前端 (Vite) ───────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SKIP_AUTH_GUARD=false

# ── CORS (后端) ──────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 生产部署 (可选) ───────────────────────────
# BACKEND_HOST=localhost
# BACKEND_PORT=8000
# PORT=3000
